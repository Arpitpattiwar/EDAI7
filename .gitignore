# ============================================================
# Mumbai UHI PINN — .gitignore
# ============================================================

# ------------------------------------------------------------
# Python Virtual Environment
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
.env

# ------------------------------------------------------------
# Python Cache & Compiled Files
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.spec

# ------------------------------------------------------------
# Jupyter Notebooks
# ------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ------------------------------------------------------------
# Data Files (large / binary / generated)
# Keep directory structure via .gitkeep files
# ------------------------------------------------------------
data/raw/
data/processed/*.parquet
data/processed/*.csv
data/processed/*.nc
data/vector/*.shp
data/vector/*.dbf
data/vector/*.shx
data/vector/*.prj
data/vector/*.cpg
data/vector/*.qpj

# Allow small reference files if needed
!data/**/.gitkeep

# ------------------------------------------------------------
# Model Weights & Checkpoints (large binary files)
# ------------------------------------------------------------
results/models/*.pt
results/models/*.pth
results/models/*.joblib
results/models/*.pkl
results/models/*.h5
results/models/*.ckpt

# ------------------------------------------------------------
# Generated Figures & Metric Logs
# (re-generated by running the pipeline)
# ------------------------------------------------------------
results/figures/*.png
results/figures/*.pdf
results/figures/*.svg
results/metrics/*.json
results/metrics/*.csv

# Keep directory structure
!results/**/.gitkeep

# ------------------------------------------------------------
# Google Earth Engine Credentials
# ------------------------------------------------------------
~/.config/earthengine/
credentials.json
service_account_key.json
*.json_key
gee_token*

# ------------------------------------------------------------
# GeoTIFF / Raster / Remote Sensing Files (very large)
# ------------------------------------------------------------
*.tif
*.tiff
*.geotiff
*.img
*.hdf
*.h4
*.h5
*.nc
*.nc4
*.zarr

# ------------------------------------------------------------
# IDE / Editor Files
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# OS Artifacts
# ------------------------------------------------------------
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# Logs & Temp Files
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
logs/
tmp/
temp/

# ------------------------------------------------------------
# Coverage & Testing
# ------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
coverage.xml
*.cover

# ------------------------------------------------------------
# Distribution / Packaging
# ------------------------------------------------------------
*.manifest
*.whl
MANIFEST

# ------------------------------------------------------------
# MyPy / Type Checking
# ------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json

# ------------------------------------------------------------
# Secrets / API Keys (never commit these)
# ------------------------------------------------------------
.env
.env.*
*.secret
secrets.py
config_local.py

